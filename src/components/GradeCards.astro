---
const grades = [
  { g: 'A+', note: 'Все повышающие переменные', items: ['LRL, замедление, консолидация перед KL', 'Сильное отклонение к границе', 'Подтверждение объёма на X-1'] },
  { g: 'A', note: 'Часть переменных', items: ['Нет одной из ключевых', 'Нет понижающих'] },
  { g: 'B', note: 'Есть понижающие', items: ['Сильный тренд', 'Близость середины диапазона'] },
];
---
<div class="grid3">{grades.map((x) => (
  <div class="card"><div class="g">{x.g}</div>{x.note}<ul>{x.items.map((i) => <li>{i}</li>)}</ul></div>
))}</div>
