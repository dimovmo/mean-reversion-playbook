---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

// Тело .md-файла термина — текст окна «Подробнее»; без тела и скринов кнопки нет — хватает краткого d
// Без английской расшифровки описание начинается с заглавной
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);

const terms = (await getCollection('glossary'))
  .map((x) => ({ id: x.id, body: x.body?.trim(), entry: x, ...x.data }))
  .sort((a, b) => a.term.localeCompare(b.term));
const data = Object.fromEntries(terms.map((x) => [x.id, {
  term: x.term,
  en: x.en ?? '',
  // скрины из шапки термина (images), как в примерах
  imgs: x.images.map((im) => im.src),
  lights: x.images.map((im) => im.light ?? im.src),
  caps: x.images.map((im) => im.label ?? ''),
}]));
const bodies = await Promise.all(terms.map(async (x) => ({ id: x.id, Content: x.body ? (await render(x.entry)).Content : null })));
---
<Base title="Глоссарий — Mean Reversion">
  <div class="wrap">
    <h2>Глоссарий</h2>
    <dl class="dl gl">
      {terms.map((x) => (
        <>
          <dt id={x.id} class="mono">{x.term}</dt>
          <dd>{x.en ? <><b>{x.en}</b> — {x.d}</> : cap(x.d)}{(x.body || x.images.length > 0) && <><br /><button class="ex-btn" data-id={x.id} aria-haspopup="dialog">Подробнее</button></>}</dd>
        </>
      ))}
    </dl>
  </div>

  <dialog id="gm" class="gm" aria-labelledby="gm-t">
    <div class="gm-head">
      <div><h3 id="gm-t" class="mono"></h3><span class="gm-en"></span></div>
      <button class="gm-x" aria-label="Закрыть">✕</button>
    </div>
    <div class="gm-sl">
      <img alt="" />
      <button class="gm-nav gm-prev" aria-label="Предыдущий скрин"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button class="gm-nav gm-next" aria-label="Следующий скрин"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      <span class="gm-cap" hidden></span>
      <span class="gm-cnt"></span>
    </div>
    <div class="gm-txt"></div>
  </dialog>

  {bodies.map(({ id, Content }) => (
    <template data-more={id}>{Content ? <Content /> : <p>{cap(terms.find((x) => x.id === id)!.d)}</p>}</template>
  ))}
  <script type="application/json" id="gm-data" set:html={JSON.stringify(data)} />
  <script is:inline>
    const DATA = JSON.parse(document.getElementById('gm-data').textContent);
    const PH = '/examples/placeholder.svg';
    const dlg = document.getElementById('gm'), $ = (s) => dlg.querySelector(s);
    const img = $('.gm-sl img'), prev = $('.gm-prev'), next = $('.gm-next'), cnt = $('.gm-cnt'), capEl = $('.gm-cap');
    let list = [], caps = [], i = 0, alt = '';
    // своё имя: скрипт Base.astro тоже объявляет глобальный isLight
    const gmLight = () => getComputedStyle(document.documentElement).colorScheme.includes('light');

    // Пока новый скрин не загрузился, img скрыт, иначе мелькает прошлый
    // фон слайдера = цвет угла скрина, чтобы картинка не сидела в рамке
    const bgCv = document.createElement('canvas'); bgCv.width = bgCv.height = 1;
    const matchBg = () => {
      try {
        const c = bgCv.getContext('2d', { willReadFrequently: true });
        c.drawImage(img, 2, 2, 1, 1, 0, 0, 1, 1);
        const [r, g, b] = c.getImageData(0, 0, 1, 1).data;
        img.parentElement.style.background = `rgb(${r},${g},${b})`;
      } catch { img.parentElement.style.background = ''; }
    };
    img.onload = () => { img.style.visibility = ''; matchBg(); };
    img.onerror = () => { if (!img.src.endsWith(PH)) img.src = PH; else img.style.visibility = ''; };
    const show = (n) => {
      i = (n + list.length) % list.length;
      const url = new URL(list[i], location.href).href;
      if (img.src !== url) { img.style.visibility = 'hidden'; img.src = url; }
      if (img.complete && img.naturalWidth) img.style.visibility = '';
      const c = caps[i] || '';
      capEl.textContent = c; capEl.hidden = !c;
      img.alt = c ? `${alt} — ${c}` : list.length > 1 ? `${alt} — пример ${i + 1} из ${list.length}` : alt;
      cnt.textContent = `${i + 1} / ${list.length}`;
    };

    const open = (id) => {
      const x = DATA[id]; if (!x) return;
      $('#gm-t').textContent = x.term;
      $('.gm-en').textContent = x.en;
      const tpl = document.querySelector(`template[data-more="${CSS.escape(id)}"]`);
      $('.gm-txt').replaceChildren(tpl.content.cloneNode(true));
      list = x.imgs.length ? (gmLight() ? x.lights : x.imgs) : [PH]; caps = x.imgs.length ? x.caps : []; alt = x.en || x.term;
      dlg.classList.toggle('one', list.length < 2);
      show(0);
      // Остальные скрины грузим заранее, чтобы листание не дёргалось
      list.slice(1).forEach((u) => { new Image().src = u; });
      dlg.showModal();
    };

    document.querySelectorAll('.ex-btn').forEach((b) => b.addEventListener('click', () => open(b.dataset.id)));
    prev.onclick = () => show(i - 1);
    next.onclick = () => show(i + 1);
    $('.gm-x').onclick = () => dlg.close();
    // Клик по затемнению вокруг окна закрывает его
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (list.length < 2) return;
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    // Свайп на телефоне
    let x0 = null;
    img.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    img.addEventListener('touchend', (e) => {
      if (x0 === null || list.length < 2) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1));
    });
  </script>
</Base>
