---
import Base from '../layouts/Base.astro';
import books from '../data/books.json';
---
<Base title="Литература — Mean Reversion">
  <div class="wrap">
    <h2>Литература</h2>
    {books.map((g) => (
      <>
        <h4>{g.group}</h4>
        <div class="books">
          {g.items.map((b) => (
            <div class="bk"><div class="cover"></div>
              <div><b>{b.title}{b.author && ` · ${b.author}`}</b>
                <div class="tags"><span class="tag">{b.type}</span><span class="tag">{b.level}</span></div>
                <p>{b.why}</p></div></div>
          ))}
        </div>
      </>
    ))}
  </div>
</Base>
