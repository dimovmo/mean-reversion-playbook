---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('examples')).sort((a, b) => +b.data.date - +a.data.date);
  return all.map((entry, i) => ({ params: { id: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const stages = [['Контекст', d.images.context], ['Вход', d.images.entry], ['Результат', d.images.outcome]];
---
<Base title={`${d.pair} ${d.direction} — Mean Reversion`}>
  <div class="wrap" style="max-width:900px">
    <a href="/examples">← Все примеры</a>
    <h2 style="margin-top:12px">{d.pair} · {d.direction}</h2>
    <div class="tags"><span class="tag">{d.market}</span><span class="tag gr">{d.grade}</span><span class="tag">{d.tf}</span><span class="tag">RR {d.rr}</span><span class="tag">{d.result}</span></div>
    <div class="tabs">{stages.map(([label], i) => <button data-i={i} class={i === 0 ? 'on' : ''}>{label}</button>)}</div>
    <div class="big"><img id="main" src={stages[0][1]} alt={d.pair} /></div>
    <dl class="dl"><dt>Цель</dt><dd>{d.target}</dd></dl>
    <h3 style="margin-top:24px">Разбор</h3>
    <Content />
    <div class="pn">
      <span>{prev && <a href={`/examples/${prev.id}`}>← {prev.data.pair}</a>}</span>
      <span>{next && <a href={`/examples/${next.id}`}>{next.data.pair} →</a>}</span>
    </div>
  </div>
  <div id="lb"><img alt="" /></div>
  <script define:vars={{ srcs: stages.map((s) => s[1]) }}>
    const main = document.getElementById('main'), lb = document.getElementById('lb');
    document.querySelectorAll('.tabs button').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.tabs button').forEach((x) => x.classList.toggle('on', x === b));
      main.src = srcs[b.dataset.i];
    }));
    main.addEventListener('click', () => { lb.firstElementChild.src = main.src; lb.classList.add('on'); });
    lb.addEventListener('click', () => lb.classList.remove('on'));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') lb.classList.remove('on'); });
  </script>
</Base>
