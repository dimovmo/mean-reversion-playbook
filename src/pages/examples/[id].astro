---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('examples')).sort((a, b) => +b.data.date - +a.data.date);
  return all.map((entry, i) => ({ params: { id: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.pair} ${d.direction} — Mean Reversion`}>
  <div class="wrap trade-wrap">
    <a href="/examples">← Все примеры</a>
    <h2 style="margin-top:12px">{d.pair}</h2>
    <div class="tags"><span class={`tag ${d.direction}`}>{d.direction}</span><span class="tag">{d.date.toISOString().slice(0, 10)}</span><span class="tag">{d.market}</span><span class="tag">{d.result}</span><span class="tag">RR {d.rr}</span></div>
    <div class="trade">
      <div class="shots">
        {d.images.map((im, i) => (
          <figure class="big">
            <img src={im.src} alt={`${d.pair}${im.label ? ` ${im.label}` : ''}`} loading={i === 0 ? 'eager' : 'lazy'} />
            {im.label && <figcaption class="tag">{im.label}</figcaption>}
          </figure>
        ))}
      </div>
      <aside class="card tcard">
        <h4>Thesis</h4><p>{d.thesis || '—'}</p>
        {[['SL', d.sl], ['TP', d.tp]].map(([h, xs]) => <>
          <h4>{h}</h4>
          {xs.length > 1
            ? <ol class="lv">{xs.map((x) => <li>{x}</li>)}</ol>
            : <p>{xs[0] || '—'}</p>}
        </>)}
        <h4>Entry</h4><p>{d.entry || '—'}</p>
        {d.ev.length > 0 && <>
          <h4>Pros</h4>
          <div class="ev">{d.ev.map((x) => <span class="evt">{x}</span>)}</div>
        </>}
        <h4>Comment</h4><div class="tc-body"><Content /></div>
      </aside>
    </div>
    <div class="pn">
      <span>{prev && <a href={`/examples/${prev.id}`}>← {prev.data.pair}</a>}</span>
      <span>{next && <a href={`/examples/${next.id}`}>{next.data.pair} →</a>}</span>
    </div>
  </div>
  <div id="lb"><img alt="" /></div>
  <script is:inline>
    const lb = document.getElementById('lb');
    document.querySelectorAll('.big img').forEach((img) => img.addEventListener('click', () => { lb.firstElementChild.src = img.src; lb.classList.add('on'); }));
    lb.addEventListener('click', () => lb.classList.remove('on'));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') lb.classList.remove('on'); });
  </script>
</Base>
