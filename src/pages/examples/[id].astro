---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('examples')).sort((a, b) => +b.data.date - +a.data.date);
  return all.map((entry, i) => ({ params: { id: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.pair} ${d.direction} — Mean Reversion`}>
  <div class="wrap trade-wrap">
    <a href="/examples">← Все примеры</a>
    <h2 style="margin-top:12px">{d.pair}</h2>
    <div class="tags"><span class={`tag ${d.direction}`}>{d.direction}</span><span class="tag">{d.date.toISOString().slice(0, 10)}</span><span class="tag">{d.market}</span><span class="tag">{d.result}</span><span class={`tag ${d.result === 'Стоп' ? 'Short' : 'Long'}`}>{d.result === 'Стоп' ? '−1R' : `+${d.rr}R`}</span></div>
    <div class="trade">
      <div class="shots">
        {d.images.map((im, i) => (
          <figure class="big">
            <img class={im.light && 'th-dark'} src={im.src} alt={`${d.pair}${im.label ? ` ${im.label}` : ''}`} loading={i === 0 ? 'eager' : 'lazy'} />
            {im.light && <img class="th-light" src={im.light} alt={`${d.pair}${im.label ? ` ${im.label}` : ''}`} loading="lazy" />}
            {im.label && <figcaption class="tag">{im.label}</figcaption>}
          </figure>
        ))}
      </div>
      <aside class="card tcard">
        <h4>Thesis</h4><p>{d.thesis || '—'}</p>
        {[['SL', d.sl], ['TP', d.tp]].map(([h, xs]) => <>
          <h4>{h}</h4>
          {xs.length > 1
            ? <ol class="lv">{xs.map((x) => <li>{x}</li>)}</ol>
            : <p>{xs[0] || '—'}</p>}
        </>)}
        <h4>Entry</h4><p>{d.entry || '—'}</p>
        <h4>Comment</h4><div class="tc-body"><Content /></div>
      </aside>
    </div>
    <div class="pn">
      <span>{prev && <a href={`/examples/${prev.id}`}>← {prev.data.pair}</a>}</span>
      <span>{next && <a href={`/examples/${next.id}`}>{next.data.pair} →</a>}</span>
    </div>
  </div>
  <div id="lb"><img alt="" /></div>
  <script is:inline>
    const lb = document.getElementById('lb');
    const lbImg = lb.firstElementChild;
    // Пока новый скрин не загрузился, img скрыт, иначе мелькает прошлый
    lbImg.onload = lbImg.onerror = () => { lbImg.style.visibility = ''; };
    document.querySelectorAll('.big img').forEach((img) => img.addEventListener('click', () => {
      if (lbImg.src !== img.src) { lbImg.style.visibility = 'hidden'; lbImg.src = img.src; }
      if (lbImg.complete && lbImg.naturalWidth) lbImg.style.visibility = '';
      lb.classList.add('on');
    }));
    lb.addEventListener('click', () => lb.classList.remove('on'));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') lb.classList.remove('on'); });
  </script>
</Base>
